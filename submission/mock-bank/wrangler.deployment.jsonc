{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "freya-hackathon-bank-oguzhan",
  "main": "evidence/deployment/compiled/index.js",
  "compatibility_date": "2026-10-11",
  "workers_dev": true,
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "BANK_SESSIONS",
        "class_name": "BankSession"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "BankSession"
      ]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "vars": {
    "BANK_BUNDLE_SHA256": "3891df0c3f2b38d7da21faf96fb07ae5cc765cd2a4e0603aaad167311489c440",
    "BANK_CONTRACT_SHA256": "692414a06036911509072d602b6c85bf38cbf2c791d26488d53d28be1cf35470",
    "BANK_CUSTOMER_FIXTURE_SHA256": "009d3609d33a3b001ce04861822cd2592cb5482a7a5b0a5cb69442592889aa65"
  }
}
