{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Verified bank deployment receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bank_ready",
    "worker_name",
    "base_url",
    "health_url",
    "deployment_id",
    "cloudflare_version_id",
    "deployed_at_utc",
    "bundle",
    "configuration",
    "contract",
    "customer_fixtures",
    "source_files",
    "storage",
    "contract_tests"
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Path relative to the FreyaHackaton repository."
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  },
  "properties": {
    "schema_version": {
      "const": 1
    },
    "bank_ready": {
      "const": true
    },
    "worker_name": {
      "type": "string",
      "minLength": 1
    },
    "base_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "health_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "deployment_id": {
      "type": "string",
      "minLength": 1
    },
    "deployed_at_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "bundle": {
      "$ref": "#/$defs/artifact"
    },
    "configuration": {
      "$ref": "#/$defs/artifact"
    },
    "contract": {
      "$ref": "#/$defs/artifact"
    },
    "customer_fixtures": {
      "$ref": "#/$defs/artifact"
    },
    "source_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend",
        "persistence_verified",
        "customer_isolation_verified",
        "evidence"
      ],
      "properties": {
        "backend": {
          "type": "string",
          "minLength": 1
        },
        "persistence_verified": {
          "const": true
        },
        "customer_isolation_verified": {
          "const": true
        },
        "evidence": {
          "$ref": "#/$defs/artifact"
        }
      }
    },
    "contract_tests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passed",
        "case_count",
        "report"
      ],
      "properties": {
        "passed": {
          "const": true
        },
        "case_count": {
          "type": "integer",
          "minimum": 1
        },
        "report": {
          "$ref": "#/$defs/artifact"
        }
      }
    },
    "cloudflare_version_id": {
      "type": "string",
      "minLength": 1,
      "description": "Worker version ID reported by CF_VERSION_METADATA.id; distinct from deployment ID."
    }
  }
}
