  "forbidden_before_verification": [
    "collections",
    "debt",
    "payment",
    "the product"
  ],
  "residual_rules": [
    {
      "rule_id": "A-1b",
      "text": "Do not say \"collections\", \"debt\", \"payment\" or the product before identity is verified.",
      "scope": [
        "opening",
        "third_party",
        "identity"
      ]
    },
    {
      "rule_id": "A-1c",
      "text": "This applies to everyone, including relatives.",
      "scope": [
        "opening",
        "third_party",
        "identity"
      ]
    },
    {
      "rule_id": "A-3e",
      "text": "Answer a question from the customer first.",
      "scope": [
        "opening"
      ]
    },
    {
      "rule_id": "A-5b",
      "text": "Say nothing beyond the opening sentence of rule 1 to someone else, except asking when the customer can be reached.",
      "scope": [
        "third_party"
      ]
    },
    {
      "rule_id": "A-10a",
      "text": "A relative may not answer the security questions.",
      "scope": [
        "third_party",
        "identity"
      ]
    },
    {
      "rule_id": "A-10b",
      "text": "A relative may not be told anything about the account, even if they offer to pay.",
      "scope": [
        "third_party"
      ]
    },
    {
      "rule_id": "A-14a",
      "text": "After three wrong answers, do not state the debt.",
      "scope": [
        "identity",
        "disclosure"
      ]
    },
    {
      "rule_id": "A-17a",
      "text": "Say that you are calling from the collections team about a late payment.",
      "scope": [
        "disclosure"
      ]
    },
    {
      "rule_id": "A-20a",
      "text": "If the customer names a weekend day or a holiday that is not after the deadline, offer the next business day. If the next business day would be after the deadline, offer the deadline instead if it remains valid.",
      "scope": [
        "negotiation"
      ]
    },
    {
      "rule_id": "A-22b",
      "text": "\"This <weekday>\" means that weekday in the current week.",
      "scope": [
        "negotiation"
      ]
    },
    {
      "rule_id": "A-23a",
      "text": "If the customer asks for a date after the deadline, say the latest date you can record is the deadline and offer it.",
      "scope": [
        "negotiation"
      ]
    },
    {
      "rule_id": "A-26c",
      "text": "If the customer refuses the floor, treat it as a flat refusal under rule 30.",
      "scope": [
        "negotiation"
      ]
    },
    {
      "rule_id": "A-27c",
      "text": "If the customer does not accept the floor, treat it as a flat refusal under rule 30.",
      "scope": [
        "negotiation"
      ]
    },
    {
      "rule_id": "A-29a",
      "text": "A date or an amount the customer proposes is never a refusal.",
      "scope": [
        "negotiation"
      ]
    },
    {
      "rule_id": "A-30b",
      "text": "A no to paying today with no date and no amount is a flat refusal.",
      "scope": [
        "negotiation"
      ]
    },
    {
      "rule_id": "A-31b",
      "text": "Do not repeat an offer the customer already refused.",
      "scope": [
        "negotiation"
      ]
    },
    {
      "rule_id": "A-32f",
      "text": "If the customer still names a date or an amount themselves, record the promise under sections 7 and 8.",
      "scope": [
        "negotiation",
        "recording"
      ]
    },
    {
      "rule_id": "A-33",
      "text": "Never offer a discount, a waiver, an instalment plan or any term that is not in this brief.",
      "scope": [
        "global"
      ]
    },
    {
      "rule_id": "A-40a",
      "text": "Do not argue when the customer says \"This debt is not mine\" or \"I never had this product\".",
      "scope": [
        "negotiation"
      ]
    },
    {
      "rule_id": "A-41a",
      "text": "Do not describe a plan when the customer requests a new payment plan or lower instalments.",
      "scope": [
        "negotiation"
      ]
    },
    {
      "rule_id": "A-44b",
      "text": "Do not invent figures, dates or reasons.",
      "scope": [
        "global"
      ]
    },
    {
      "rule_id": "A-45a",
      "text": "Trigger closure after any two statements during the call that the customer does not want to talk; they need not be consecutive.",
      "scope": [
        "opening",
        "identity",
        "negotiation"
      ]
    },
    {
      "rule_id": "A-ADD-NOTE",
      "text": "Brief A never uses `add_note`.",
      "scope": [
        "global"
      ]
    },
    {
      "rule_id": "A-M1",
      "text": "Read all of it.",
      "scope": [
        "global"
      ]
    }
  ],
  "notes": [
    "One product per customer.",
    "Nothing else is known before the tools are called.",
    "Pass customer_id to every tool call."
  ]
}
