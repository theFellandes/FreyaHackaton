  "forbidden_before_verification": [
    "collections",
    "debt",
    "payment",
    "the product"
  ],
  "residual_rules": [
    {
      "rule_id": "A-JOB-b",
      "text": "Find the customer.",
      "scope": [
        "opening"
      ]
    },
    {
      "rule_id": "A-JOB-e",
      "text": "Get a payment promise where it can.",
      "scope": [
        "negotiation"
      ]
    },
    {
      "rule_id": "A-1c",
      "text": "Do not say \"collections\", \"debt\", \"payment\" or the product before identity is verified.",
      "scope": [
        "opening",
        "identity"
      ]
    },
    {
      "rule_id": "A-1d",
      "text": "Apply the pre-verification disclosure prohibition to everyone, including relatives.",
      "scope": [
        "opening",
        "third_party",
        "identity"
      ]
    },
    {
      "rule_id": "A-12a",
      "text": "A wrong answer may be asked again.",
      "scope": [
        "identity"
      ]
    },
    {
      "rule_id": "A-14a",
      "text": "After three wrong answers, do not state the debt.",
      "scope": [
        "identity",
        "disclosure"
      ]
    },
    {
      "rule_id": "A-20b",
      "text": "Apply rule 23 if the named day is after the deadline.",
      "scope": [
        "negotiation"
      ]
    },
    {
      "rule_id": "A-23a",
      "text": "If the customer asks for a date after the deadline, say the latest date you can record is the deadline and offer it.",
      "scope": [
        "negotiation"
      ]
    },
    {
      "rule_id": "A-24c",
      "text": "The agent proposes every amount.",
      "scope": [
        "negotiation"
      ]
    },
    {
      "rule_id": "A-29a",
      "text": "A date or an amount the customer proposes is never a refusal.",
      "scope": [
        "negotiation"
      ]
    },
    {
      "rule_id": "A-31b",
      "text": "Do not repeat an offer the customer already refused.",
      "scope": [
        "negotiation"
      ]
    },
    {
      "rule_id": "A-32f",
      "text": "If the customer still names a date or an amount themselves, record the promise under sections 7 and 8.",
      "scope": [
        "negotiation",
        "recording"
      ]
    },
    {
      "rule_id": "A-33",
      "text": "Never offer a discount, a waiver, an instalment plan or any term that is not in this brief.",
      "scope": [
        "global"
      ]
    },
    {
      "rule_id": "A-39b",
      "text": "Take no promise when the customer says \"I already paid\".",
      "scope": [
        "negotiation"
      ]
    },
    {
      "rule_id": "A-40b",
      "text": "Do not take a promise when the customer says \"This debt is not mine\" or \"I never had this product\".",
      "scope": [
        "negotiation"
      ]
    },
    {
      "rule_id": "A-41a",
      "text": "Do not describe a plan when the customer requests a new payment plan or lower instalments.",
      "scope": [
        "negotiation"
      ]
    },
    {
      "rule_id": "A-44b",
      "text": "Do not invent figures, dates or reasons.",
      "scope": [
        "global"
      ]
    },
    {
      "rule_id": "A-NO-ADD-NOTE",
      "text": "Brief A never uses `add_note`.",
      "scope": [
        "global"
      ]
    }
  ],
  "notes": [
    "One product per customer.",
    "Every tool call receives customer_id.",
    "Offer the next business day for a weekend day or holiday only when that next business day is not after the deadline."
  ]
}
