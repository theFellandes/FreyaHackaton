  "forbidden_before_verification": [
    "collections",
    "debt",
    "payment",
    "the product"
  ],
  "residual_rules": [
    {
      "rule_id": "A-JOB-b",
      "text": "Find the customer, check identity, state the debt, get a payment promise where it can, and close the call with the correct outcome.",
      "scope": [
        "global"
      ]
    },
    {
      "rule_id": "A-VARS-a",
      "text": "Pass customer_id to every tool call.",
      "scope": [
        "global"
      ]
    },
    {
      "rule_id": "A-1c",
      "text": "Do not say \"collections\", \"debt\", \"payment\" or the product before identity is verified to anyone, including relatives.",
      "scope": [
        "opening",
        "third_party",
        "identity"
      ]
    },
    {
      "rule_id": "A-3e",
      "text": "Answer a question from the customer before the following ask.",
      "scope": [
        "opening"
      ]
    },
    {
      "rule_id": "A-3f",
      "text": "Treat the ask following the customer's question as the second ask.",
      "scope": [
        "opening"
      ]
    },
    {
      "rule_id": "A-11d",
      "text": "Treat any value the service cannot read as a date as rejected.",
      "scope": [
        "identity"
      ]
    },
    {
      "rule_id": "A-12a",
      "text": "A wrong security answer may be asked again.",
      "scope": [
        "identity"
      ]
    },
    {
      "rule_id": "A-14a",
      "text": "Do not state the debt after three wrong answers.",
      "scope": [
        "identity",
        "disclosure"
      ]
    },
    {
      "rule_id": "A-15c",
      "text": "Treat asking what the call is about instead of answering as declining.",
      "scope": [
        "identity"
      ]
    },
    {
      "rule_id": "A-20b",
      "text": "If the named day is after the deadline, rule 23 applies.",
      "scope": [
        "negotiation"
      ]
    },
    {
      "rule_id": "A-20a",
      "text": "If the next business day after a named weekend day or holiday would be after the deadline, do not offer it.",
      "scope": [
        "negotiation"
      ]
    },
    {
      "rule_id": "A-23a",
      "text": "For a single product, if the customer asks for a date after the deadline, say the latest date you can record is the deadline and offer it.",
      "scope": [
        "negotiation"
      ]
    },
    {
      "rule_id": "B-6a",
      "text": "If one shared requested date is after one product's deadline, record that product on its own deadline; the other products keep the named date.",
      "scope": [
        "negotiation",
        "recording"
      ]
    },
    {
      "rule_id": "A-26c",
      "text": "Treat a refusal of the floor as a flat refusal under rule 30.",
      "scope": [
        "negotiation"
      ]
    },
    {
      "rule_id": "A-27c",
      "text": "Treat failure to accept the floor as a flat refusal under rule 30.",
      "scope": [
        "negotiation"
      ]
    },
    {
      "rule_id": "A-29a",
      "text": "A date or an amount the customer proposes is never a refusal.",
      "scope": [
        "negotiation"
      ]
    },
    {
      "rule_id": "A-31b",
      "text": "Do not repeat an offer the customer already refused.",
      "scope": [
        "negotiation"
      ]
    },
    {
      "rule_id": "A-32g",
      "text": "If the customer still names a date or an amount themselves after hardship, record the promise under sections 7 and 8.",
      "scope": [
        "negotiation",
        "confirmation",
        "recording"
      ]
    },
    {
      "rule_id": "A-33",
      "text": "Never offer a discount, a waiver, an instalment plan or any term that is not in this brief.",
      "scope": [
        "global"
      ]
    },
    {
      "rule_id": "A-34b",
      "text": "Call create_promise only after a clear yes.",
      "scope": [
        "recording"
      ]
    },
    {
      "rule_id": "B-7c",
      "text": "After the one confirmation, call create_promise once per promised product.",
      "scope": [
        "recording"
      ]
    },
    {
      "rule_id": "B-10c",
      "text": "Do not record promises agreed but not yet recorded when a restructuring request occurs.",
      "scope": [
        "recording"
      ]
    },
    {
      "rule_id": "B-10e",
      "text": "On any transfer—restructuring, support or human—do not add notes at all before or after it.",
      "scope": [
        "recording",
        "closing"
      ]
    },
    {
      "rule_id": "B-11a",
      "text": "In a multi-product call, if one create_promise fails twice, keep promises already recorded and continue with create_promise for remaining promised products.",
      "scope": [
        "recording"
      ]
    },
    {
      "rule_id": "A-40e",
      "text": "Rule 39 covers only a payment of this past-due amount.",
      "scope": [
        "negotiation"
      ]
    },
    {
      "rule_id": "A-45a",
      "text": "Close after any two statements that the customer does not want to talk during the call, even if separated by other conversation.",
      "scope": [
        "closing"
      ]
    }
  ],
  "notes": [
    "Brief B applies Brief A except where Brief B replaces or narrows a rule.",
    "For customers with two or three late products, get_account returns one to three products and the call is not limited to one product.",
    "For each product without a promise, add a note with that product_id and the applicable reason unless the call transfers.",
    "For a multi-product call with no promise recorded, choose the reason of the first non-paid product note in get_account order."
  ]
}
