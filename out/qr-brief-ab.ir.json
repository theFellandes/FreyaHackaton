  ],
  "residual_rules": [
    {
      "rule_id": "A-1b",
      "text": "Do not say \"collections\", \"debt\", \"payment\" or the product before identity is verified.",
      "scope": [
        "opening",
        "identity"
      ]
    },
    {
      "rule_id": "A-5a",
      "text": "Do not say why you are calling to someone else.",
      "scope": [
        "third_party"
      ]
    },
    {
      "rule_id": "A-5b",
      "text": "Say nothing beyond the opening sentence of rule 1 to someone else.",
      "scope": [
        "third_party"
      ]
    },
    {
      "rule_id": "A-9b",
      "text": "Ask nothing else if someone else says the customer has died.",
      "scope": [
        "third_party"
      ]
    },
    {
      "rule_id": "A-10a",
      "text": "Do not allow a relative to answer the security questions.",
      "scope": [
        "third_party",
        "identity"
      ]
    },
    {
      "rule_id": "A-10b",
      "text": "Do not tell a relative anything about the account, even if they offer to pay.",
      "scope": [
        "third_party"
      ]
    },
    {
      "rule_id": "A-20a",
      "text": "Do not offer a next business day that is after the deadline.",
      "scope": [
        "negotiation"
      ]
    },
    {
      "rule_id": "A-23a",
      "text": "If the customer asks for a date after the deadline, say the latest date you can record is the deadline and offer it.",
      "scope": [
        "negotiation"
      ]
    },
    {
      "rule_id": "A-31b",
      "text": "Do not repeat an offer the customer already refused.",
      "scope": [
        "negotiation"
      ]
    },
    {
      "rule_id": "A-33",
      "text": "Never offer a discount, a waiver, an instalment plan or any term that is not in this brief.",
      "scope": [
        "global"
      ]
    },
    {
      "rule_id": "A-40a",
      "text": "Do not argue when the customer says \"This debt is not mine\" or \"I never had this product\".",
      "scope": [
        "negotiation"
      ]
    },
    {
      "rule_id": "A-41a",
      "text": "Do not describe a plan when the customer requests a new payment plan or lower instalments.",
      "scope": [
        "negotiation"
      ]
    },
    {
      "rule_id": "B-4c",
      "text": "Do not ask about today again for each product.",
      "scope": [
        "negotiation"
      ]
    },
    {
      "rule_id": "B-10e",
      "text": "On any transfer (restructuring, support, human) add no notes at all, before or after it.",
      "scope": [
        "recording",
        "closing"
      ]
    },
    {
      "rule_id": "B-11a",
      "text": "If one create_promise fails twice, keep the promises that were recorded and continue with later products, retaining recorded promises and noting every product that ends without a promise.",
      "scope": [
        "recording"
      ]
    }
  ],
  "notes": [
    "One to three products are handled in get_account return order.",
    "For a common customer-named weekend or holiday date that is after one product's deadline, record that overdue product on its deadline and apply business-day validation to every other product."
  ]
}
