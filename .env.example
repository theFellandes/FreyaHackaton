# -----------------------------------------------------------------------------------------------------------------
# Freya collections builder - environment variables
#
# Copy this file to `.env` (never commit `.env`) and fill in what you need. Every value is optional unless marked
# REQUIRED. Blank values (`NAME=`) are ignored, so the documented default applies. Names are case-insensitive.
# Real environment variables override `.env`. Secrets are redacted from every trace the builder writes.
# -----------------------------------------------------------------------------------------------------------------

# ===== Freya platform =============================================================================================
# REQUIRED for anything but --dry-run. Workspace API key from the Freya dashboard (starts with "fak_").
FREYA_API_KEY=
# Legacy alias of FREYA_API_KEY; used only when FREYA_API_KEY is blank.
FREYA_KEY=
# Base URL of the platform. Default: https://staging-app.freyavoice.ai
FREYA_API_URL=
# REQUIRED for practice runs (tools/run_cases.py). A team secret of 16+ characters you make up; use the same one
# every time (it identifies your team's sessions on the mock bank).
FREYA_BANK_TEAM_KEY=
# Workspace id. Default: the first workspace the key can see.
FREYA_WORKSPACE_ID=
# Where slot -> workflow/agent ids are stored so each slot's workflow is updated in place instead of re-created.
# Relative paths are resolved against the repository root. Default: .freya-agents.json
FREYA_STATE_FILE=
# Minimum seconds between two Freya API calls (be polite; the rules forbid load-testing the platform). Default: 0.25
FREYA_MIN_INTERVAL_S=
# Personal dashboard login kept out of git. Not read by the builder.
FREYA_DASHBOARD_PASSWORD=

# --- kit variables (read by the kit's freya.py / tools, listed for completeness) ---
# FREYA_AGENT_PROVIDER / FREYA_AGENT_MODEL: the phone agent's model. Reserved for the organisers - do NOT set them;
#   the builder never touches them.
# FREYA_SIM_CONCURRENCY: concurrent calls in a practice simulation. Kit default: 5
# FREYA_BANK_HOST: mock bank host used by tools/score.py. Kit default: https://freya-bank-mock.freyavoice.workers.dev

# ===== LLM keys (the "key changer" rotates keys within a provider, then providers in LLM_PROVIDERS order) =========
# Each provider P accepts P_API_KEY, P_API_KEY_1 ... P_API_KEY_20 and P_API_KEYS (comma/semicolon/newline separated).
# Duplicates are ignored; keys are tried in that order. A key without credits is remembered as dead (see
# LLM_KEY_HEALTH_FILE) and skipped by later runs.
ANTHROPIC_API_KEY=
ANTHROPIC_API_KEY_1=
ANTHROPIC_API_KEY_2=
ANTHROPIC_API_KEYS=
OPENAI_API_KEY=
OPENAI_API_KEY_1=
OPENAI_API_KEY_2=
OPENAI_API_KEYS=
# The claude_code provider uses the local Claude login (~/.claude/.credentials.json) or this OAuth token.
# If that login is not valid the CLI answers "Not logged in"; the provider is then marked dead and skipped.
CLAUDE_CODE_OAUTH_TOKEN=

# ===== LLM gateway ================================================================================================
# Provider chain, tried in order. Default: anthropic,openai,claude_code
LLM_PROVIDERS=
# Models per provider and role (STRONG = understanding/extraction, FAST = audits and small tasks).
# Defaults are the cheaper tiers: claude-sonnet-5-5 / claude-haiku-5-5 (anthropic and claude_code),
# gpt-5.6-terra / gpt-5.6-luna (openai).
ANTHROPIC_STRONG_MODEL=
ANTHROPIC_FAST_MODEL=
OPENAI_STRONG_MODEL=
OPENAI_FAST_MODEL=
CLAUDE_CODE_STRONG_MODEL=
CLAUDE_CODE_FAST_MODEL=
# Timeout of one model call in seconds. Default: 300
LLM_TIMEOUT_S=
# Output token limit of one model call. Default: 16000
LLM_MAX_TOKENS=
# Retries of transient errors (overloaded, 5xx, timeout, connection) on the same key before rotating. Default: 2
LLM_RETRIES_PER_KEY=
# Cooldown of a rate-limited key when the provider sends no retry-after header, in seconds. Default: 30
LLM_RATE_LIMIT_COOLDOWN_S=
# Longest wait for a cooling key when no other key or provider is left, in seconds. Default: 45
LLM_MAX_COOLDOWN_WAIT_S=
# Dead-key memory (fingerprints only, never secrets). Relative to the repository root. Default: data/key_health.json
LLM_KEY_HEALTH_FILE=
# How long a dead key stays skipped, in seconds. Default: 21600 (6 hours)
LLM_DEAD_KEY_TTL_S=

# ===== LLM rate limiting (client side; keeps the builder below the provider limits, 0 = unlimited) ===============
# Provider calls in flight at the same time over all providers. Default: 2
LLM_MAX_CONCURRENCY=
# Requests per minute per (provider, key). Default: 30
LLM_RPM_PER_KEY=
# Estimated tokens per minute per (provider, key). Default: 150000
LLM_TPM_PER_KEY=
# Minimum seconds between two call starts on the same key. Default: 0.5
LLM_MIN_INTERVAL_S=
# Per-provider limits that replace the two defaults above, as provider=rpm:tpm pairs.
# Example: openai=60:200000,anthropic=30:100000
LLM_RATE_OVERRIDES=

# ===== Observability: see exactly what the LLMs were sent and answered ===========================================
# Always on, no setup: every LLM attempt (prompt + reply) goes to traces/<slot>-<time>.llm.jsonl with secrets masked.
# Optional Langfuse (install the extra first: uv sync --extra obs). Both keys must be set to turn it on. Use the keys
# of a Langfuse Cloud project, or of your own server (docker-compose.langfuse.yml).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Langfuse server. Default: https://cloud.langfuse.com (EU cloud). US cloud: https://us.cloud.langfuse.com.
# Self-hosted: http://localhost:3000
LANGFUSE_HOST=
# false = send only metadata (token counts, timings, lengths) to Langfuse, not prompt or reply texts. Default: true
# This switch governs Langfuse only; the local log below is governed by LLM_LOG_CONTENT.
OBSERVABILITY_LOG_PROMPTS=
# What the local traces/<slot>-<time>.llm.jsonl keeps of every LLM attempt: full | metadata. Default: full
# full = prompt and reply texts (read what the models said); metadata = ids, tokens, timings and text lengths only.
LLM_LOG_CONTENT=

# ===== Build ======================================================================================================
# Builder track: compiled | agentic | auto. Default: compiled (the configuration measured live; auto = compiled
# first with the agentic track as fallback, an opt-in)
BUILDER_TRACK=
# Workflow shape produced by the compiler: staged | lean. Default: staged
AGENT_PROFILE=
# Wall-clock budget of one build in seconds, self-tests included (hackathon limit: 30 min). Default: 1680
BUILD_TIME_BUDGET_S=
# Self-test after deployment: smoke | none | auto | walkthrough | practice. Default: smoke (auto, walkthrough and
# practice are opt-ins: their findings can start a policy repair round and a redeploy)
SELF_TEST=
# Fixed slot (workflow label). Default: derived from the brief file names, e.g. brief-a
BUILD_SLOT=
# true = compile and check locally, make no Freya calls. Default: false
DRY_RUN=
# Repair budgets. Defaults: 2 policy repairs, 2 compile repairs, 1 self-test repair
MAX_POLICY_REPAIRS=
MAX_COMPILE_REPAIRS=
MAX_SELFTEST_REPAIRS=
