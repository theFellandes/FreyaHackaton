    "payment",
    "card",
    "loan",
    "the name of any product"
  ],
  "residual_rules": [
    {
      "rule_id": "D1-JOB-a",
      "text": "Call only customers who are 1 to 60 days overdue on a product.",
      "scope": [
        "global"
      ]
    },
    {
      "rule_id": "D1-JOB-b",
      "text": "Find the customer, check identity, state the arrears, obtain a payment promise where possible, and close the call with the correct outcome.",
      "scope": [
        "global"
      ]
    },
    {
      "rule_id": "D1-VARS-a",
      "text": "Do not treat anything other than the call variables as known before calling the tools.",
      "scope": [
        "global"
      ]
    },
    {
      "rule_id": "D1-VARS-b",
      "text": "Pass customer_id to every tool call.",
      "scope": [
        "global"
      ]
    },
    {
      "rule_id": "D1-1b",
      "text": "Do not say \"arrears\", \"overdue\", \"payment\", \"card\", \"loan\" or the name of any product before identity is verified.",
      "scope": [
        "opening",
        "third_party",
        "identity"
      ]
    },
    {
      "rule_id": "D1-20a",
      "text": "Do not offer a next business day that is after the deadline; apply the after-deadline handling.",
      "scope": [
        "negotiation"
      ]
    },
    {
      "rule_id": "D1-31b",
      "text": "Do not repeat an offer the customer already refused.",
      "scope": [
        "negotiation"
      ]
    },
    {
      "rule_id": "D1-33",
      "text": "Never offer a discount, a waiver, a payment holiday, or any term that is not in this brief.",
      "scope": [
        "global"
      ]
    },
    {
      "rule_id": "D1-40a",
      "text": "Do not argue when the customer says \"This debt is not mine\" or \"I never had this product\".",
      "scope": [
        "negotiation"
      ]
    },
    {
      "rule_id": "D1-41a",
      "text": "Do not describe a plan in response to a request for a new payment plan or lower instalments.",
      "scope": [
        "negotiation"
      ]
    },
    {
      "rule_id": "D1-44b",
      "text": "Do not invent figures, dates or reasons.",
      "scope": [
        "global"
      ]
    },
    {
      "rule_id": "D1-M1",
      "text": "Read all of it.",
      "scope": [
        "global"
      ]
    }
  ],
  "notes": [
    "One or two overdue products are returned by get_account.",
    "Every tool call includes customer_id.",
    "Use title plus last_name once identity is verified.",
    "A relative cannot answer security questions or receive account information.",
    "For a two-product customer, already paid and dispute are noted per product and the call continues with the other product."
  ]
}
