        "situation": "product_notes",
        "when": "With no promise recorded, every product is noted paid.",
        "rule_ids": [
          "B-CLOSING-b"
        ],
        "requires_verified": true
      },
      {
        "outcome": "transferred",
        "reason": "restructuring",
        "situation": "transfer:restructuring",
        "when": "A restructuring request transfers the call.",
        "rule_ids": [
          "A-OUTCOMES-c",
          "B-10d"
        ],
        "requires_verified": true
      },
      {
        "outcome": "transferred",
        "reason": "human",
        "situation": "transfer:general",
        "when": "The customer insists on a human.",
        "rule_ids": [
          "A-OUTCOMES-c",
          "A-42b",
          "A-42c"
        ]
      },
      {
        "outcome": "transferred",
        "reason": "support",
        "situation": "transfer:support",
        "when": "The customer accepts connection with customer support.",
        "rule_ids": [
          "A-OUTCOMES-c",
          "A-32c"
        ],
        "requires_verified": true
      },
      {
        "outcome": "no_promise",
        "reason": "refused",
        "situation": "product_notes",
        "when": "With no promise recorded, the first product in get_account order whose note is not paid has reason refused.",
        "rule_ids": [
          "A-31c",
          "A-45a",
          "B-CLOSING-c"
        ],
        "requires_verified": true
      },
      {
        "outcome": "no_promise",
        "reason": "hardship",
        "situation": "product_notes",
        "when": "With no promise recorded, the first product in get_account order whose note is not paid has reason hardship.",
        "rule_ids": [
          "A-32d",
          "B-CLOSING-c"
        ],
        "requires_verified": true
      },
      {
        "outcome": "no_promise",
        "reason": "dispute",
        "situation": "product_notes",
        "when": "With no promise recorded, the first product in get_account order whose note is not paid has reason dispute.",
        "rule_ids": [
          "A-40c",
          "B-CLOSING-c"
        ],
        "requires_verified": true
      },
      {
        "outcome": "no_promise",
        "reason": "service_error",
        "situation": "product_notes",
        "when": "With no promise recorded, the first product in get_account order whose note is not paid has reason service_error.",
        "rule_ids": [
          "A-37c",
          "B-CLOSING-c"
        ],
        "requires_verified": true
      },
      {
        "outcome": "not_verified",
        "reason": "failed",
        "situation": "identity_failed",
        "when": "After three wrong answers.",
        "rule_ids": [
          "A-14c",
          "A-OUTCOMES-e"
        ],
        "requires_verified": false
      },
      {
        "outcome": "not_verified",
        "reason": "declined",
        "situation": "identity_declined",
        "when": "After a second refusal or a second question asking what the call is about instead of answering.",
        "rule_ids": [
          "A-15b",
          "A-15d",
          "A-45b",
          "A-OUTCOMES-e"
        ],
        "requires_verified": false
      },
      {
        "outcome": "not_reached",
        "reason": "callback",
        "situation": "callback_booked",
        "when": "A callback was scheduled.",
        "rule_ids": [
          "A-6b",
          "A-OUTCOMES-f"
        ],
        "requires_verified": false
      },
      {
        "outcome": "not_reached",
        "reason": "no_callback",
        "situation": "callback_not_booked",
        "when": "The second offered callback day or time is outside the callback window.",
        "rule_ids": [
          "A-7c",
          "A-OUTCOMES-f"
        ],
        "requires_verified": false
      },
      {
        "outcome": "not_reached",
        "reason": "wrong_number",
        "situation": "wrong_number",
        "when": "The person says the number does not belong to the customer.",
        "rule_ids": [
          "A-8",
          "A-OUTCOMES-f"
        ],
        "requires_verified": false
      },
      {
        "outcome": "not_reached",
        "reason": "deceased",
        "situation": "deceased",
        "when": "The person says the customer has died.",
        "rule_ids": [
          "A-9c",
          "A-OUTCOMES-f"
        ],
        "requires_verified": false
      },
      {
        "outcome": "not_reached",
        "reason": "unclear",
        "situation": "unclear_party",
        "when": "It is still unclear after the second ask.",
        "rule_ids": [
          "A-3d",
          "A-OUTCOMES-f"
        ],
        "requires_verified": false
      }
    ],
    "precedence": [
      "transfer:restructuring",
      "transfer:support",
      "transfer:general",
      "promise_recorded",
      "identity_failed",
      "identity_declined",
      "wrong_number",
      "deceased",
      "callback_booked",
      "callback_not_booked",
      "unclear_party",
      "product_notes"
    ],
    "promise_wins": true,
    "transfer_after_promise_outcome": {
      "outcome": "transferred"
    },
    "goodbye_before_close": true,
    "close_last_exactly_once": true
  },
  "forbidden_before_verification": [
    "collections",
    "debt",
    "payment",
    "the product"
  ],
  "residual_rules": [
    {
      "rule_id": "A-JOB-a",
      "text": "Call customers who are 1 to 45 days late on one product.",
      "scope": [
        "global"
      ]
    },
    {
      "rule_id": "A-M1",
      "text": "Call customers who are 1 to 45 days late on one product.",
      "scope": [
        "global"
      ]
    },
    {
      "rule_id": "A-1b",
      "text": "Do not say \"collections\", \"debt\", \"payment\" or the product before identity is verified.",
      "scope": [
        "opening",
        "third_party",
        "identity"
      ]
    },
    {
      "rule_id": "A-1c",
      "text": "Apply the pre-verification disclosure restriction to everyone, including relatives.",
      "scope": [
        "opening",
        "third_party",
        "identity"
      ]
    },
    {
      "rule_id": "A-3e",
      "text": "Answer a question from the customer before the follow-up ask.",
      "scope": [
        "opening"
      ]
    },
    {
      "rule_id": "A-3f",
      "text": "Treat the ask that follows an answer to the customer's question as the second ask.",
      "scope": [
        "opening"
      ]
    },
    {
      "rule_id": "A-5b",
      "text": "Say nothing beyond the opening sentence of rule 1 to someone else who answers, except ask when the customer can be reached.",
      "scope": [
        "third_party"
      ]
    },
    {
      "rule_id": "A-9b",
      "text": "If the person says the customer has died, ask nothing else.",
      "scope": [
        "third_party"
      ]
    },
    {
      "rule_id": "A-10a",
      "text": "Do not allow a relative to answer the security questions.",
      "scope": [
        "third_party",
        "identity"
      ]
    },
    {
      "rule_id": "A-10b",
      "text": "Do not tell a relative anything about the account, even if they offer to pay.",
      "scope": [
        "third_party"
      ]
    },
    {
      "rule_id": "A-12a",
      "text": "A wrong answer may be asked again.",
      "scope": [
        "identity"
      ]
    },
    {
      "rule_id": "A-14a",
      "text": "Do not state the debt after three wrong answers.",
      "scope": [
        "identity",
        "disclosure"
      ]
    },
    {
      "rule_id": "A-15c",
      "text": "Count asking what the call is about instead of answering as declining.",
      "scope": [
        "identity"
      ]
    },
    {
      "rule_id": "A-15d",
      "text": "A second refusal or a second question asking what the call is about instead of answering closes the call.",
      "scope": [
        "identity",
        "closing"
      ]
    },
    {
      "rule_id": "A-16",
      "text": "Call get_account after both security questions pass.",
      "scope": [
        "identity",
        "disclosure"
      ]
    },
    {
      "rule_id": "A-17a",
      "text": "Say that you are calling from the collections team about a late payment.",
      "scope": [
        "disclosure"
      ]
    },
    {
      "rule_id": "A-17b",
      "text": "Name the product in words as \"credit card ending 4821\", \"personal loan\" or \"car loan\".",
      "scope": [
        "disclosure"
      ]
    },
    {
      "rule_id": "A-17c",
      "text": "State the past-due amount and how many days late it is.",
      "scope": [
        "disclosure"
      ]
    },
    {
      "rule_id": "A-20b",
      "text": "Apply rule 23 if the named day is after the deadline.",
      "scope": [
        "negotiation"
      ]
    },
    {
      "rule_id": "A-21a",
      "text": "Ask once for the exact day when the customer gives a vague period such as \"next week\", \"end of the month\", or \"when my salary comes\".",
      "scope": [
        "negotiation"
      ]
    },
    {
      "rule_id": "A-23a",
      "text": "Tell the customer that the latest date you can record is the deadline and offer the deadline when they ask for a date after it.",
      "scope": [
        "negotiation"
      ]
    },
    {
      "rule_id": "A-24c",
      "text": "The agent proposes every amount.",
      "scope": [
        "negotiation"
      ]
    },
    {
      "rule_id": "A-26c",
      "text": "Treat a customer's refusal of the floor as a flat refusal under rule 30.",
      "scope": [
        "negotiation"
      ]
    },
    {
      "rule_id": "A-27c",
      "text": "Treat a customer's failure to accept the floor as a flat refusal under rule 30.",
      "scope": [
        "negotiation"
      ]
    },
    {
      "rule_id": "A-29a",
      "text": "Never treat a date or amount the customer proposes as a refusal.",
      "scope": [
        "negotiation"
      ]
    },
    {
      "rule_id": "A-29b",
      "text": "Handle a date or amount proposed by the customer under sections 7 and 8.",
      "scope": [
        "negotiation"
      ]
    },
    {
      "rule_id": "A-30b",
      "text": "A no to paying today with no date and no amount is a flat refusal.",
      "scope": [
        "negotiation"
      ]
    },
    {
      "rule_id": "A-30c",
      "text": "Use the full past-due amount for Attempt 1, or use the floor if the customer already said the full amount is too much.",
      "scope": [
        "negotiation"
      ]
    },
    {
      "rule_id": "A-31b",
      "text": "Do not repeat an offer the customer already refused.",
      "scope": [
        "negotiation"
      ]
    },
    {
      "rule_id": "A-32f",
      "text": "If the customer still names a date or an amount themselves, record the promise under sections 7 and 8.",
      "scope": [
        "negotiation",
        "confirmation",
        "recording"
      ]
    },
    {
      "rule_id": "A-33",
      "text": "Never offer a discount, a waiver, an instalment plan, or any term that is not in this brief.",
      "scope": [
        "global"
      ]
    },
    {
      "rule_id": "A-34b",
      "text": "Call create_promise only after a clear yes, except that under the multi-product workflow one confirmation applies to all promises.",
      "scope": [
        "recording"
      ]
    },
    {
      "rule_id": "A-36b",
      "text": "Do not change or cancel a recorded promise in the same call.",
      "scope": [
        "recording"
      ]
    },
    {
      "rule_id": "A-37a",
      "text": "Say the promise is recorded only after create_promise returns ok: true.",
      "scope": [
        "recording"
      ]
    },
    {
      "rule_id": "A-39b",
      "text": "When the customer says \"I already paid\", take no promise for that product.",
      "scope": [
        "negotiation"
      ]
    },
    {
      "rule_id": "A-40a",
      "text": "Do not argue when the customer says \"This debt is not mine\" or \"I never had this product\".",
      "scope": [
        "negotiation"
      ]
    },
    {
      "rule_id": "A-40b",
      "text": "Do not take a promise when the customer says \"This debt is not mine\" or \"I never had this product\".",
      "scope": [
        "negotiation"
      ]
    },
    {
      "rule_id": "A-41a",
      "text": "Do not describe a plan when the customer requests a new payment plan or lower instalments.",
      "scope": [
        "negotiation"
      ]
    },
    {
      "rule_id": "A-45c",
      "text": "Apply rule 42 before and after verification.",
      "scope": [
        "global"
      ]
    },
    {
      "rule_id": "A-46a",
      "text": "End every call with exactly one close_call with an outcome and, where the table lists one, a reason.",
      "scope": [
        "closing"
      ]
    },
    {
      "rule_id": "A-46b",
      "text": "Make close_call the last tool call.",
      "scope": [
        "closing"
      ]
    },
    {
      "rule_id": "A-TRANSFER-PROMISE",
      "text": "If a transfer follows a recorded promise, close as transferred with that transfer's reason.",
      "scope": [
        "closing"
      ]
    },
    {
      "rule_id": "B-4b",
      "text": "If the customer cannot pay all products today, go through the products one by one in the order get_account returned them.",
      "scope": [
        "negotiation"
      ]
    },
    {
      "rule_id": "B-4c",
      "text": "Do not ask about today again for each product.",
      "scope": [
        "negotiation"
      ]
    },
    {
      "rule_id": "B-6a",
      "text": "If the customer names one date for everything and it is after one product's deadline, record that product on its own deadline and say so in the read-back.",
      "scope": [
        "negotiation",
        "confirmation"
      ]
    },
    {
      "rule_id": "B-6b",
      "text": "Keep the date the customer named for the other products.",
      "scope": [
        "negotiation",
        "confirmation"
      ]
    },
    {
      "rule_id": "B-8a",
      "text": "Allow the customer to promise some products and refuse others.",
      "scope": [
        "negotiation"
      ]
    },
    {
      "rule_id": "B-8b",
      "text": "For each product without a promise, call add_note with that product_id and a reason of refused, hardship, dispute, paid or service_error, unless a transfer occurs.",
      "scope": [
        "recording"
      ]
    },
    {
      "rule_id": "B-8c",
      "text": "Call add_note for each product without a promise even when no product gets a promise, unless a transfer occurs.",
      "scope": [
        "recording"
      ]
    },
    {
      "rule_id": "B-9a",
      "text": "Do not end the call for a dispute or an \"already paid\" claim on one product.",
      "scope": [
        "negotiation"
      ]
    },
    {
      "rule_id": "B-9b",
      "text": "Add a dispute note for a disputed product and a paid note for an already-paid product, then continue with the other products, unless a transfer occurs.",
      "scope": [
        "negotiation",
        "recording"
      ]
    },
    {
      "rule_id": "B-10b",
      "text": "Keep promises recorded before a restructuring request.",
      "scope": [
        "recording",
        "closing"
      ]
    },
    {
      "rule_id": "B-10c",
      "text": "Do not record promises agreed but not yet recorded when there is a restructuring request.",
      "scope": [
        "recording",
        "closing"
      ]
    },
    {
      "rule_id": "B-10e",
      "text": "On any transfer (restructuring, support, human), add no notes at all before or after it.",
      "scope": [
        "recording",
        "closing"
      ]
    },
    {
      "rule_id": "B-11a",
      "text": "If one create_promise fails twice, keep the promises that were recorded.",
      "scope": [
        "recording"
      ]
    },
    {
      "rule_id": "B-11b",
      "text": "If one create_promise fails twice, call add_note with reason service_error for the failed product, unless a transfer occurs.",
      "scope": [
        "recording"
      ]
    },
    {
      "rule_id": "A-ADD-NOTE",
      "text": "Never use `add_note` in Brief A.",
      "scope": [
        "global"
      ]
    }
  ],
  "notes": [
    "Brief B applies with one to three products returned by get_account.",
    "For a one-product call, the Brief A single-product closure behavior applies; for multiple products, add per-product notes and use the multi-product closing rule."
  ]
}
